-- AUTO TP
TPSection:NewToggle("Auto TP","",function(state)

    autoTPOn = state

    if state then

        if not spawnPos then

            notify("Guarda un spawn primero")

            autoTPOn = false

            return
        end

        iniciarLoop()

        notify("Auto TP activado")

    else

        detenerLoop()

        notify("Auto TP desactivado")
    end
end)

-- RESET TPs
TPSection:NewButton("Resetear TPs","",function()

    tpCount = 0

    notify("TPs reiniciados")

end)

