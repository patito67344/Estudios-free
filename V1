-- META
LevelSection:NewTextBox(
    "Nivel Meta",
    "Ejemplo: 100",
    function(v)

        local num = tonumber(v)

        if num then

            levelEnd = num

            notify("Meta "..num)
        end
    end
)

-- AUTO LEVEL
LevelSection:NewToggle("Auto Level","",function(state)

    getgenv().levelFarming = state

    if state then

        notify("Auto Level activado")

        task.spawn(function()

            while getgenv().levelFarming do

                task.wait(1)

                local lvl = getCurrentLevel()

                if lvl then

                    if lvl >= levelEnd then

                        getgenv().levelFarming = false

                        notify("Meta alcanzada")

                        pcall(function()

                            local sound = Instance.new("Sound")

                            sound.SoundId = "rbxassetid://4612362038"

                            sound.Volume = 1

                            sound.Parent = workspace

                            sound:Play()

                            Debris:AddItem(sound,5)

                        end)

                        task.wait(3)

                        lp:Kick(
                            "Nivel "..lvl.." alcanzado"
                        )

                        break
                    end
                end
            end
        end)

    else

        notify("Auto Level desactivado")
    end
end)

