local lp = Players.LocalPlayer

-- =========================================
-- VARIABLES
-- =========================================

local spawnPos      = nil
local autoTPOn      = false
local velocidad     = 0.001
local tpCount       = 0
local loopThread    = nil
local noclipConn    = nil

local tpPlayerLoop  = nil
local tpOffset      = 3
local loopSpeed     = 0.1

_G.tplayer = nil

getgenv().levelFarming = false
getgenv().loopgoto = false

local levelEnd = 100

-- =========================================
-- HELPERS
-- =========================================

local function notify(txt)

    game.StarterGui:SetCore("SendNotification",{
        Title = "GRAVEDAD",
        Text = txt,
        Duration = 3
    })

end

local function getChar()

    return lp.Character or lp.CharacterAdded:Wait()

end

local function getRootPart()

    local char = getChar()

    return char and char:FindFirstChild("HumanoidRootPart")

end

local function getTarget()

    if not _G.tplayer then
        return nil
    end

    local p = Players:FindFirstChild(_G.tplayer)

    if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        return p
    end
end

local function GetPlayerList()

    local t = {}

    for _,v in pairs(Players:GetPlayers()) do

        if v ~= lp then
            table.insert(t,v.Name)
        end
    end

    return t
end

-- =========================================
-- TP SPAWN
-- =========================================

local function tpAhora()

    if not spawnPos then

        notify("Primero guarda un spawn")

        return false
    end

    local root = getRootPart()

    if root then

        root.CFrame = spawnPos

        tpCount = tpCount + 1

        return true
    end

    return false
end

local function iniciarLoop()

    if loopThread then

        task.cancel(loopThread)

        loopThread = nil
    end

    loopThread = task.spawn(function()

        while autoTPOn do

            tpAhora()

            task.wait(velocidad)
        end
    end)
end

local function detenerLoop()

    if loopThread then

        task.cancel(loopThread)

        loopThread = nil
    end
end

-- =========================================
-- LEVEL SYSTEM
-- =========================================

local function getCurrentLevel()

    local player = lp

    local checks = {

        function()
            return player.leaderstats
            and player.leaderstats:FindFirstChild("Level")
            and player.leaderstats.Level.Value
        end,

        function()
            return player.leaderstats
            and player.leaderstats:FindFirstChild("Nivel")
            and player.leaderstats.Nivel.Value
        end,

        function()
            return player.leaderstats
            and player.leaderstats:FindFirstChild("lvl")
            and player.leaderstats.lvl.Value
        end,

        function()
            return player.leaderstats
            and player.leaderstats:FindFirstChild("LVL")
            and player.leaderstats.LVL.Value
        end
    }

    for _,check in pairs(checks) do

        local ok,val = pcall(check)

        if ok and type(val) == "number" then

            return val
        end
    end

    return nil
end

