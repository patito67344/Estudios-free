end)

-- TP DETRAS
PlayerSection:NewButton("TP Detras","",function()

    local target = getTarget()
    local root = getRootPart()

    if target and root then

        root.CFrame =
            target.Character.HumanoidRootPart.CFrame
            * CFrame.new(0,0,-tpOffset)

        notify("Teleport detras")
    end
end)

-- LOOP TP PLAYER
PlayerSection:NewToggle("Loop TP","",function(state)

    getgenv().loopgoto = state

    if state then

        tpPlayerLoop = task.spawn(function()

            while getgenv().loopgoto do

                task.wait(loopSpeed)

                pcall(function()

                    local target = getTarget()
                    local root = getRootPart()

                    if target and root then

                        root.CFrame =
                            target.Character.HumanoidRootPart.CFrame
                            * CFrame.new(0,0,tpOffset)

                    end
                end)
            end
        end)

        notify("Loop TP activado")

    else

        if tpPlayerLoop then

            task.cancel(tpPlayerLoop)
        end

        notify("Loop TP desactivado")
    end
end)

